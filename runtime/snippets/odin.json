{
		"fmtp": {
			"prefix": "fmtp",
			"body": "fmt.println($0)"
		},
		"fmtf": {
			"prefix": "fmtf",
			"body": "fmt.printf($1, $0)"
		},
		"proc": {
			"prefix": "proc",
			"body": "$1 :: proc($2){\n\t$0\n}\n"
		},
		"st": {
			"prefix": "st",
			"body": "$1 :: struct{\n\t$0\n}\n"
		},
		"if": {
			"prefix": "if",
			"body": "if $1 {\n$0\n}\n"
		},
		"iferr": {
			"prefix": "iferr",
			"body": "if err != nil {\n$0\n}\n"
		}
}


